# ============================================================
#  Nexus Mesh · .gitignore
# ============================================================
#  设计原则：本地真实配置、运行时状态、密钥一律不入库。
#  这样在推送 GitHub 之前，无需逐文件检查敏感信息。
# ============================================================

# ---------- 本地真实配置（★ 重要）----------
# 仓库只保留 *.example.yaml；真实成员名单、真实任务类型、
# 真实域名与凭据都放这里，永不入库。
config/local.yaml
config/*.local.yaml
config/local/
config/members.yaml
config/nxs.yaml
config/secrets.yaml

# ---------- 密钥与凭据（★ 重要）----------
*.key
*.pem
*.crt
*.p12
.env
.env.*
secrets/
credentials/

# 【唯一的例外】自签 CA 的**公开证书**。
#
# 上面的 *.pem 是防私钥泄露的安全网，默认拒绝一切 PEM 是对的。
# 但 CA 公钥证书必须随代码分发 —— 客户端没有它就无法验证服务端，
# 而让用户手工粘贴 PEM 实测会引入 BOM / 截断 / 存成 .txt 等各种损坏，
# 每一种的报错都看不出是编码问题。
#
# 安全性：ca.pem 只含**公钥**。CA 私钥（ca.key）仍被 *.key 拦住，
# 永远不会入库。泄露 ca.pem 不构成风险 —— 它本来就是给所有节点看的。
#
# ⚠ 只放这一份。绝不要在此添加 server.pem 或任何 *.key 的例外：
#   server.key 是服务端私钥，泄露可直接冒充服务端。
!deploy/ca.pem

# ---------- 运行时状态 ----------
.nxs/
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3
run/
logs/
*.log

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.python-version

# ---------- 测试与工具缓存 ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ---------- 编辑器与系统 ----------
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---------- 个人笔记（防止误提交）----------
NOTES.md
TODO.local.md
*.private.md
.nxs-backup
