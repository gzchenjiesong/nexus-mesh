# ==============================================================================
#  Nexus Mesh · 生产环境配置模板
# ==============================================================================
#  用法：
#      sudo install -m 600 -o nxs -g nxs deploy/local.yaml.example \
#           /etc/nexus-mesh/local.yaml
#      然后按下面注释填真实值。
#
#  ⚠ 这个文件里**不出现任何凭据**。凭据全部走 /etc/nexus-mesh/nxs.env。
# ==============================================================================

server:
  # ⚠ 生产环境建议改 0.0.0.0 才能被外网节点连到。
  #   但**更推荐**保持 127.0.0.1 + 前置 Nginx/Caddy 做 TLS 终止与限流：
  #   那样证书轮换、WAF、访问日志都能复用系统里成熟的东西。
  host: 127.0.0.1
  port: 8443

  max_body_bytes: 262144

  # ---- TLS ----
  # 若用前置代理（推荐），这里留空，由代理终止 TLS。
  # 若让 nxs 自己终止 TLS，填这两项：
  # tls_cert: /etc/letsencrypt/live/nxs.example.com/fullchain.pem
  # tls_key:  /etc/letsencrypt/live/nxs.example.com/privkey.pem

  # ---- 传输层自保 ----
  max_concurrent_requests: 64
  max_sse_streams: 16
  sse_enabled: true
  sse_keepalive_seconds: 15

# ------------------------------------------------------------------------------
# 存储
# ------------------------------------------------------------------------------
# ⚠ **生产必须用 sqlite，不能用 memory。**
#   memory 后端进程退出即丢——重启后所有节点注册、所有在途任务全没了，
#   节点必须重新注册、重新批准。那等于每次部署都是一次事故。
stores:
  queue: sqlite
  registry: sqlite
  audit: file
  data_dir: /var/lib/nexus-mesh

# ------------------------------------------------------------------------------
# 策略
# ------------------------------------------------------------------------------
policy:
  # 每节点每秒请求上限。设 0 表示不限——**不建议**，
  # 那等于把抗洪水的能力交给前置代理。
  rate_limit_per_second: 20

  # ★ 启动时自动批准的信任域。**生产建议留空。**
  #   留空 = 任何节点都要运维显式批准（nxs ops approve）。
  #   留非空会让该域下所有节点自动获批——包括未来新接入的。
  auto_approve_domains: []

  # ★ 权限矩阵的维度是「域 × 类型」，不是「节点 × 节点」。
  #   新增节点只需归属到既有域，规则自动继承。
  #   没有匹配规则的「域 × 域」一律拒绝（默认拒绝）。
  matrix:
    # ★ 只表达可达性（权限模型改造 · Step 4）
    #
    #   类型权限归 role.serves，应答上限归 role + 节点自限取 min。
    #   这里只回答一个问题：这批数据能被谁触达。
    #
    # ⚠ 代价：进 cloud 域的 driver 可以向工作域发**任意已定义类型**。
    #   域隔离挡住跨域乱发，但域内不再有第二道限制 ——
    #   所以「进哪个域」这个审批就变得格外重要。
    - from_domain: cloud
      to_domain: zone-work

    # 工作域 → 协调域：允许向上回传（内网节点主动问云端 Agent 时用）
    - from_domain: zone-work
      to_domain: cloud

    # 家里那台（低优先级，暂不开放）
    # - from_domain: cloud
    #   to_domain: zone-home

# ------------------------------------------------------------------------------
# 信任域
# ------------------------------------------------------------------------------
# ⭐ **这一段是生产配置的关键，也决定了校验的严格程度。**
#
#   矩阵的维度是「域 → 域」，而工作电脑上的节点**在协调节点启动时还不存在**
#   （它靠自注册接入）。所以域必须在这里显式声明，否则矩阵里写
#   `cloud → zone-work` 会被判为"引用了不存在的域"。
#
#   ⚠ 声明了这一段，就等于告诉系统"这个部署会接纳自注册节点"——
#     因此矩阵只表达可达性（不再列类型），类型权限归 role.serves。
#
#   不声明这一段时（demo / 测试的配置），系统会退化为从节点卡片推导域。
#
# ------------------------------------------------------------------------------
# 本进程承载的节点
# ------------------------------------------------------------------------------
# ⭐ **这一项不加，协调节点必然会变成 stale。**
#
#   存活判定是"超过 heartbeat_interval × 3 没有心跳 → stale"。
#   这条规则对远端节点是对的，但协调节点是**本进程内的节点** ——
#   没有任何东西会给它发心跳（它自己就是服务端）。
#   于是启动 3 个心跳周期后它必然被判 stale，而后果是：
#     · 观察窗里"协调中枢 ● stale"看着像核心挂了（误导）
#     · capability_index 按 routable 过滤 → 它声明的能力在匹配器眼里消失
#
#   所以必须显式声明"这台机器承载的是哪个节点"。
#   **不要理解成"配置里的节点都是本进程"** —— nodes: 段也可以登记远端节点
#   （为了锁定它的信任域），那种节点该由它自己心跳。替它续命等于让一台
#   已经死掉的机器永远显示 alive，那比 stale 更危险。
#
#   留空 = 本进程不承载任何节点（那种部署里没有本地节点要续命）。
local_node: coordinator

# ------------------------------------------------------------------------------
# 信任域
# ------------------------------------------------------------------------------
#   另外：节点自报的域必须属于这里声明的域之一，否则运维批准时会看到
#   一个陌生的域名而无法判断。**信任域是运维划的边界，不是节点自选的房间。**
domains:
  - name: cloud
    description: 协调域（云端，人机入口）。域名取 cloud 而不是 coordinator——域是**位置**，节点是**角色**
  - name: zone-work
    description: 办公内网（工作电脑上的执行节点）
  - name: zone-home
    description: 家庭内网（本地 NAS 节点，暂未接入）

# ------------------------------------------------------------------------------
# 节点
# ------------------------------------------------------------------------------
# ⚠ 这里**只放协调节点自己**。工作电脑上的节点走自注册（POST /nxs/register），
#   不需要提前写在这里——这正是 v0.3 解掉的那个部署阻塞。
#
#   例外：如果你想让某个节点的**信任域由配置锁定**（不让它自报），
#   就在这里登记它的 node_id 与 domain（哪怕其余字段简写）。
#   配置里有的节点，domain 一律以配置为准。
nodes:
  - node_id: coordinator
    domain: cloud
    display_name: "Coordinator"
    roles:
      issuer: true
      executor: true
      human_interface: true
    capabilities:
      - type: work.summary
        level: summary
        mode: sync
        description: "把多个子结果合成结论"
        params_schema:
          inputs: "string"
        response_fields: [summary, level]
    constraints:
      # ⚠ 必须 ≥ 上方能力的 level（summary），否则自相矛盾：
      #   声明"我能产出 summary 级结论"却说"我最多返回 metadata 级"。
      #   这个字段曾是 metadata，导致 nxs verify 直接 FAIL —— 模板自身的 bug。
      max_response_level: summary
      # 不接收任何人的委托（它是发起方）
      can_receive_from: []
      can_issue_types: ["work.*"]
      can_delegate_to: []
      quota:
        tasks_per_day: 2000
        bytes_per_response: 131072
        bytes_per_day: 33554432
        concurrent_tasks: 8
