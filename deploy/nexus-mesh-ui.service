[Unit]
Description=Nexus Mesh · 只读观察窗（本机网页看板）
Documentation=https://github.com/gzchenjiesong/nexus-mesh
# hub 没起也不影响本服务（它会在页面上显示「hub 不可达」），
# 所以用 Wants 而不是 Requires —— 观察窗最该工作的时刻正是 hub 出事时。
After=network-online.target nexus-mesh.service
Wants=network-online.target

[Service]
Type=simple
User=nxs
Group=nxs
WorkingDirectory=/opt/nexus-mesh

# ⚠⚠ 凭据只给 OPS 密钥，**不要指向 nxs.env**（2026-11-13 修）
#
# nxs.env 是给常驻进程用的**全量**凭据文件，里面有：
#
#     NXS_OPS_SECRET            ← 观察窗只需要这一个
#     NXS_SECRET_COORDINATOR    ← 不需要
#     NXS_SECRET_HERMES_WORKING ← 不需要
#     NXS_SECRET_TASKFLOW       ← 不需要
#     NXS_SECRET_WORK_DESKTOP   ← 不需要
#     NXS_SECRET_WORK_MACBOOK   ← 不需要
#
# 实测确认过：改之前 UI 进程环境里六把密钥全在。
# **一个只读观察窗握着网络里全部 5 个节点的身份** —— 它一旦被攻破，
# 攻击者拿到的不是只读运维通道，而是能直接冒充任一节点发任务的完整身份。
#
# 这与「不做写操作」不在一个量级：前者防误操作，**这一条防提权**。
#
# ui.env 只有一行，由 deploy/install-ui-env.sh 生成。
EnvironmentFile=/etc/nexus-mesh/ui.env
Environment=PYTHONUNBUFFERED=1

# ── 凭据失效后的自动恢复（2026-11-13） ─────────────────────────────
#
# token 没有 TTL，失效只有两种成因：服务重启、浏览器关掉。原来失效后
# 401 页面教用户「去服务器跑 journalctl」——可用户在浏览器里，没终端。
#
# 配上这一行后，401 页面会自动跳回 hub 的 /api/nexus-enter 换新 token。
# 那条路径本身在 Authelia 两因素认证后面，且会自己从 journald 取最新
# token，所以**不放松任何安全边界**：token 仍随机、仍重启即换、仍不落盘。
#
# 这不是凭据，所以写在 unit 里而不是 ui.env（那个文件只放密钥）。
# 改域名时改这一行。留空（删掉整行）→ 401 只给手动说明，不自动跳。
Environment=NXS_UI_RECOVER_URL=https://hub.i-strategy-compass.cn/api/nexus-enter

# ── token 代数（轮换开关） ────────────────────────────────────────────
#
# token 由 NXS_OPS_SECRET 派生，**重启不变**，所以部署不再踢掉在线标签页。
# 代价是失去"重启即止血"，改为**显式轮换**：把下面这个数字加一，重启。
#
#     0 → 1     所有已发出的 token 立刻作废
#
# 什么时候需要：怀疑链接泄露过（截图、转发、录屏、贴到工单里）、
# 或者有人离职/失去信任。
#
# ⚠ 轮换后旧标签会 401，但不会卡死 —— 401 页面会自动跳回 hub 换新 token
#   （见上面的 NXS_UI_RECOVER_URL），人几乎无感。
#
# 也可以直接用脚本：bash deploy/rotate-ui-token.sh
#
# ⚠⚠ **这个值刻意不写在这里，而是放 /etc/nexus-mesh/ui.env。**
#
# 原因实测（2026-11-13）：unit 是**模板**，由部署脚本从仓库同步过来。
# 而 gen 会在运维轮换时改变 —— 两件事冲突：
#
#     ① 运维跑 rotate-ui-token.sh  → 改 unit，gen 0 → 1（旧 token 作废）
#     ② 下次部署                  → 从仓库同步 unit，gen 又被写回 0
#     ③ 结果：轮换被静默撤销，旧 token 重新有效
#
# 也就是说「止血」会在下一次部署时失效，而**没人会发现** —— 部署脚本
# 只会说"全部与仓库一致"。这正是本文件上半部分记的那类问题：
# 改的东西没生效，而所有输出都看起来正常。
#
# 所以：**模板放仓库（unit），运行时状态放本机（ui.env）**。
# ui.env 由 install-ui-env.sh 生成，它会保留已有的 gen 值。

# hub 用自签证书，这里是让本进程信任那张 CA。
# 只影响本进程，不碰系统证书库。
Environment=SSL_CERT_FILE=/etc/nexus-mesh/tls/ca.pem

ExecStart=/opt/nexus-mesh/.venv/bin/python -m nxs ui \
    --url https://127.0.0.1:18800/nxs --port 8080

Restart=always
RestartSec=5
TimeoutStartSec=15
TimeoutStopSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# 观察窗不写任何东西 —— 连可写路径都不给
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nexus-mesh-ui

[Install]
WantedBy=multi-user.target
